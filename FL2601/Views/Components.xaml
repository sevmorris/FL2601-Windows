<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/FL2601;component/Views/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ==================== Labels ==================== -->

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="{StaticResource SizeLabel}" />
        <Setter Property="Foreground" Value="{StaticResource GreenLo}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="Micro" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="{StaticResource SizeMicro}" />
        <Setter Property="Foreground" Value="{StaticResource Footnote}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="Instructions" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="{StaticResource SizeLabel}" />
        <Setter Property="Foreground" Value="{StaticResource Footnote}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <!-- ==================== Inputs ==================== -->

    <!--
        Shared chrome for the text inputs: black field, hairline border that
        lifts to green on focus.
    -->
    <Style x:Key="FieldChrome" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InputBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource GreenLo}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TerminalTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource GreenHi}" />
        <Setter Property="CaretBrush" Value="{StaticResource Green}" />
        <Setter Property="SelectionBrush" Value="{StaticResource GreenLo}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="TerminalPasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource GreenHi}" />
        <Setter Property="CaretBrush" Value="{StaticResource Green}" />
        <Setter Property="SelectionBrush" Value="{StaticResource GreenLo}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Placeholder shown while a field is empty. -->
    <Style x:Key="FieldPrompt" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="{StaticResource SizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource InactiveTab}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="ResultTextBox" TargetType="TextBox" BasedOn="{StaticResource TerminalTextBox}">
        <Setter Property="Foreground" Value="{StaticResource Green}" />
        <Setter Property="FontSize" Value="{StaticResource SizeResult}" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ==================== Buttons ==================== -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="{StaticResource SizeLabel}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="Black" />
        <Setter Property="Background" Value="{StaticResource GreenLo}" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="fill"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="fill" Property="Background" Value="{StaticResource Green}" />
                            <Setter TargetName="fill" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#1A6B1A" BlurRadius="10" ShadowDepth="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="fill" Property="Background" Value="{StaticResource GreenHi}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="fill" Property="Background" Value="{StaticResource Border}" />
                            <Setter TargetName="fill" Property="Effect" Value="{x:Null}" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledText}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="{StaticResource SizeLabel}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource GreenLo}" />
        <Setter Property="BorderBrush" Value="{StaticResource GreenLo}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Green}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Green}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Green}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Green}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Border}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="FontSize" Value="{StaticResource SizeMicro}" />
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <!-- ==================== Tabs ==================== -->

    <Style x:Key="TabItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,32,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent">
                        <TextBlock x:Name="label"
                                   Text="{TemplateBinding Content}"
                                   FontFamily="{StaticResource Mono}"
                                   FontSize="{StaticResource SizeBody}"
                                   Foreground="{StaticResource InactiveTab}" />
                        <Rectangle x:Name="rule" Height="2" Margin="0,4,0,0" Fill="Transparent" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                        <!-- After the hover trigger, so the active tab stays green under the pointer. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="label" Property="Foreground" Value="{StaticResource Green}" />
                            <Setter TargetName="rule" Property="Fill" Value="{StaticResource Green}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Payload map ==================== -->

    <Style x:Key="PayloadSegment" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource GreenLo}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PayloadSegmentText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <!-- ==================== Scrollbars ====================
         The stock scrollbar is light grey with arrow buttons, which reads as a
         hole punched in the panel. This is the same hairline the fields use:
         no arrows, no track, a thumb that lifts to green under the pointer. -->

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="bar" Background="{StaticResource Border}" Margin="2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bar" Property="Background" Value="{StaticResource GreenLo}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="bar" Property="Background" Value="{StaticResource Green}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                      Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                      Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== Progress ==================== -->

    <Style x:Key="ProcessingBar" TargetType="ProgressBar">
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Height" Value="2" />
        <Setter Property="Width" Value="120" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Green}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
