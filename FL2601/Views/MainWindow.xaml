<Window x:Class="FL2601.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FL2601.ViewModels"
        Title="FL2601" Width="640" Height="620"
        MinWidth="640" MinHeight="620"
        Background="#0A0A0A"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:CipherViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Base text style -->
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Courier New" />
            <Setter Property="Foreground" Value="#D6D6D6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- TextBox style -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Courier New" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#1A1A1A" />
            <Setter Property="Foreground" Value="#D6D6D6" />
            <Setter Property="CaretBrush" Value="#33FF33" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="SelectionBrush" Value="#1A6B1A" />
        </Style>

        <!-- PasswordBox style -->
        <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Courier New" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#1A1A1A" />
            <Setter Property="Foreground" Value="#D6D6D6" />
            <Setter Property="CaretBrush" Value="#33FF33" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <!-- Button style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Courier New" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#1A6B1A" />
            <Setter Property="Foreground" Value="#33FF33" />
            <Setter Property="BorderBrush" Value="#33FF33" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#237A23" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F4F0F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#222222" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#444444" />
                                <Setter Property="Foreground" Value="#555555" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab button style -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Courier New" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="BorderBrush" Value="#444444" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="0">
        <Border Background="#111111" CornerRadius="0">
            <DockPanel>
                <!-- Title bar area -->
                <Border DockPanel.Dock="Top" Background="#0A0A0A" Padding="16,12">
                    <TextBlock Text="FL2601" FontFamily="Courier New" FontSize="18"
                               FontWeight="Bold" Foreground="#33FF33" />
                </Border>

                <!-- Tab bar -->
                <Border DockPanel.Dock="Top" Background="#0A0A0A" Padding="16,0,16,0"
                        BorderBrush="#222222" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="ENCRYPT"
                                Command="{Binding SetEncryptModeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEncryptMode}" Value="True">
                                            <Setter Property="Foreground" Value="#33FF33" />
                                            <Setter Property="BorderBrush" Value="#33FF33" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="DECRYPT"
                                Command="{Binding SetDecryptModeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDecryptMode}" Value="True">
                                            <Setter Property="Foreground" Value="#33FF33" />
                                            <Setter Property="BorderBrush" Value="#33FF33" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Status bar at bottom -->
                <Border DockPanel.Dock="Bottom" Background="#0A0A0A" Padding="16,8"
                        BorderBrush="#222222" BorderThickness="0,1,0,0">
                    <TextBlock FontFamily="Courier New" FontSize="12"
                               Text="{Binding StatusMessage}"
                               Foreground="{Binding StatusBrush}" />
                </Border>

                <!-- Main content -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12">
                        <!-- Password -->
                        <TextBlock Text="PASSWORD" Style="{StaticResource MonoText}"
                                   Foreground="#999999" FontSize="11" Margin="0,0,0,4" />
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource DarkPasswordBox}"
                                     PasswordChanged="PasswordBox_PasswordChanged" />

                        <!-- Confirm Password (encrypt mode only) -->
                        <StackPanel Visibility="{Binding ConfirmPasswordVisible}" Margin="0,10,0,0">
                            <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource MonoText}"
                                       Foreground="#999999" FontSize="11" Margin="0,0,0,4" />
                            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource DarkPasswordBox}"
                                         PasswordChanged="ConfirmPasswordBox_PasswordChanged" />
                        </StackPanel>

                        <!-- Input -->
                        <TextBlock Text="INPUT" Style="{StaticResource MonoText}"
                                   Foreground="#999999" FontSize="11" Margin="0,14,0,4" />
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="120" />

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Left">
                            <Button Content="{Binding ActionLabel}"
                                    Style="{StaticResource ActionButton}"
                                    Command="{Binding EncryptCommand}" />
                            <Button Content="COPY" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CopyCommand}" Margin="8,0,0,0" />
                            <Button Content="CLEAR" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ClearCommand}" Margin="8,0,0,0" />
                        </StackPanel>

                        <!-- Busy indicator -->
                        <TextBlock Text="Processing..." Foreground="#33FF33"
                                   FontFamily="Courier New" FontSize="12" Margin="0,8,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

                        <!-- Result -->
                        <TextBlock Text="RESULT" Style="{StaticResource MonoText}"
                                   Foreground="#999999" FontSize="11" Margin="0,14,0,4" />
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding ResultText, Mode=OneWay}"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="140" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
